# EVA — plantilla de backend/.env (local). Descripción de cada variable: Docs/GUIA_ENV.md
# Nunca subir valores reales (Docs/s10/restricciones.md RX-11).

# ── Base de datos (Neon, connection string pooled) ───────────
DATABASE_URL=postgresql://user:pass@ep-xxxxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ── Auth (fastapi-users) ─────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM ──────────────────────────────────────────────────────
# Proveedores en orden de failover (Docs/s10/restricciones.md RX-06)
LLM_PROVIDERS=groq,cloudflare
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-token
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=20
LLM_PROVIDER_COOLDOWN_SECONDS=300
LLM_MAX_TOKENS=1024

# ── Email (Brevo) ────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
SMTP_FROM=your-sender@example.com
# Opcional: si falta, en local se usa http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── App ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Opcional
SENTRY_DSN=
