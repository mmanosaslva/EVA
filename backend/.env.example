# ── Base de datos ────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-bold-bread-acya5dpp-pooler.sa-east-1.aws.neon.tech/eva?statement_cache_size=0

# ── CORS ────────────────────────────────────────────────────
# Necesario para que FastAPI acepte requests del frontend
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── LLM ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=gsk_...

# ── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=https://public@your-sentry-project.ingest.us.sentry.io/123456

# ── Auth (fastapi-users) ─────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Email (SMTP Gmail) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:5173

# ── Entorno ──────────────────────────────────────────────────
ENVIRONMENT=development